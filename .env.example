# Copy this file to `.env.local` and fill in the values (see SETUP.md).
# `.env.local` is gitignored — never commit real keys.
# All VITE_ values end up in the browser, so only public keys belong here.

# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional — Cloudflare Turnstile site key (invisible captcha on the rating page)
VITE_TURNSTILE_SITE_KEY=

# Optional — Telegram bot username for low-rating alerts (without the @)
VITE_TELEGRAM_BOT_USERNAME=
